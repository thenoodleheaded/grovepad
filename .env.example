# Supabase credentials — fill these in from your project's dashboard
# (Settings → API). The app runs local-only until both are set.
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional — anonymous usage counting (PostHog). Without a key the app counts
# nothing and never downloads the analytics code. Copy the Project API key from
# PostHog → Settings → Project → Project API key; it starts with `phc_`, is
# write-only, and is safe to ship inside a client build.
# Set the host to match the region you signed up in — https://eu.i.posthog.com
# for an EU project. Leave it commented out for a US project.
VITE_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_KEY
# VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional — lets the document-import feature skip the in-app key prompt.
# GPT-5 family only (gpt-5 / gpt-5-mini).
VITE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY
