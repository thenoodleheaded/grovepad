# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# Every env file except the template. This used to list only `.env.local`, so
# `.env`, `.env.production` and friends were committable — and `.env` was in
# fact committed to a public repository. The rule is the file shape, not one
# filename, because the next secret always lands in the one that was not listed.
.env
.env.*
!.env.example
.claude/settings.local.json

# Locally generated signing material — keystores, certs, and their
# passwords. Never committed; back these up outside the repo instead.
/secrets/

# Native build output and prebuilt binaries — regenerated by Gradle/Xcode.
# Only the hand-written sources under gen/**/src and native/** are tracked.
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/android/.gradle/
src-tauri/gen/android/buildSrc/.gradle/
src-tauri/gen/android/buildSrc/build/
src-tauri/gen/apple/Externals/
src-tauri/native/apple/build/

# Local business documents that live in this folder but not in code history.
/grovepad_*.pdf

# Benchmark run artifacts — blessed baselines are copied to bench/baselines/.
/bench/results/

# Local scratch and tool output, never part of the product
tmp/_probe/
graphify-out/
