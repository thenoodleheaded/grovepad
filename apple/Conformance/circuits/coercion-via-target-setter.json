  },
  "connections": {
    "boolToCount": {
      "id": "boolToCount",
      "enabled": true,
      "fromId": "toggle",
      "fromField": "value",
      "toId": "counter",
      "kind": "value",
      "toField": "count"
    },
    "countToClamped": {
      "id": "countToClamped",
      "enabled": true,
      "fromId": "counter",
      "fromField": "count",
      "toId": "input",
      "kind": "value",
      "toField": "value",
      "transform": {
        "op": "scale",
        "factor": 100
      }
    },
    "countToText": {
      "id": "countToText",
      "enabled": true,
      "fromId": "counter",
      "fromField": "count",
      "toId": "text",
      "kind": "value",
      "toField": "text",
      "transform": {
        "op": "format",
        "template": "Count is {value}"
      }
    }
  },
  "steps": [
    {
      "label": "deliver",
      "seeds": [
        "toggle"
      ],
      "expect": {
        "writes": {
          "counter": {
            "label": "Tally",
            "count": 1,
            "step": 1,
            "skin": "tally"
          },
          "input": {
            "label": "",
            "value": 10,
            "min": 0,
            "max": 10,
            "step": 1
          },
          "text": {
            "text": "Count is 1"
          }
        },
        "firedIds": [
          "boolToCount",
          "countToClamped",
          "countToText"
        ],
        "executeRequests": [],
        "memory": {
          "boolToCount": {
            "serialized": "b:true",
            "bool": true
          },
          "countToClamped": {
            "serialized": "n:100",
            "bool": true
          },
          "countToText": {
            "serialized": "t:Count is 1",
            "bool": false
          }
        },
        "widgetsAfter": {
          "toggle": {
            "label": "Condition",
            "value": true
          },
          "counter": {
            "label": "Tally",
            "count": 1,
            "step": 1,
            "skin": "tally"
          },
          "input": {
            "label": "",
            "value": 10,
            "min": 0,
            "max": 10,
            "step": 1
          },
          "text": {
            "text": "Count is 1"
          }
        }
      }
    },
    {
      "label": "toggle off",
      "seeds": [
        "toggle"
      ],
      "edits": {
        "toggle": {
          "label": "Condition",
          "value": false
        }
      },
      "expect": {
        "writes": {
          "counter": {
            "label": "Tally",
            "count": 0,
            "step": 1,
            "skin": "tally"
          },
          "input": {
            "label": "",
            "value": 0,
            "min": 0,
            "max": 10,
            "step": 1
          },
          "text": {
            "text": "Count is 0"
          }
        },
        "firedIds": [
          "boolToCount",
          "countToClamped",
          "countToText"
        ],
        "executeRequests": [],
        "memory": {
          "boolToCount": {
            "serialized": "b:false",
            "bool": false
          },
          "countToClamped": {
            "serialized": "n:0",
            "bool": false
          },
          "countToText": {
            "serialized": "t:Count is 0",
            "bool": false
          }
        },
        "widgetsAfter": {
